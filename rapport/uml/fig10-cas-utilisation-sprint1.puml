@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
title Cas d'utilisation du Sprint 1 « Authentification et inscription »

actor "Visiteur" as V
actor "Client" as Cl
actor "Administrateur" as A
actor "Système de messagerie" as M

V --> (Créer un compte)
V --> (Réinitialiser le mot de passe)
Cl --> (S'authentifier)
Cl --> (Se déconnecter)
Cl --> (Vérifier l'adresse e-mail)
A --> (S'authentifier)
A --> (Se déconnecter)
A --> (Gérer les utilisateurs)

(S'authentifier) ..> (Vérifier les identifiants) : <<include>>
(Créer un compte) ..> (Vérifier l'adresse e-mail) : <<include>>
(Gérer les utilisateurs) ..> (S'authentifier) : <<extend>>
(Créer un compte) ..> (Envoyer l'e-mail de vérification) : <<include>>
(Envoyer l'e-mail de vérification) -> M
@enduml