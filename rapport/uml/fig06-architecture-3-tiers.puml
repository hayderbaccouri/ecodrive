@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam componentStyle rectangle
title Architecture 3-tiers d'EcoDrive

actor "Utilisateur (navigateur web)" as U

package "Couche Présentation" {
  component "Pages HTML générées côté serveur" as P1
  component "CSS + JavaScript" as P2
  component "Bibliothèques : Bootstrap, Chart.js, Leaflet" as P3
}

package "Couche Métier (PHP)" {
  component "Authentification / Inscription" as B1
  component "Catalogue et fiches (voitures, bornes)" as B2
  component "Réservation d'essais + export .ics" as B3
  component "Administration : CRUD, tableau de bord, audit" as B4
  component "Contact / Newsletter" as B5
}

package "Couche Accès aux données" {
  component "Requêtes préparées (mysqli)" as D1
  database "SGBD MySQL / MariaDB — base ecodrive" as D
}

U --> P1 : "pagine sur le site"
P1 --> P2
P1 --> P3
P1 --> B1 : "appels HTTP"
P1 --> B2
P1 --> B3
P1 --> B4
P1 --> B5
B1 --> D1 : "lecture / écriture"
B2 --> D1
B3 --> D1
B4 --> D1
B5 --> D1
D1 --> D
@enduml