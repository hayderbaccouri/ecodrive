@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
title Diagramme de séquence « Ajouter un utilisateur »

actor "Administrateur" as A
participant "Vue\n(onglet Utilisateurs)" as V
participant "admin.php\n(Contrôleur)" as C
database "Base de données\n(utilisateur)" as B
database "Journal d'audit\n(admin_audit)" as J

A -> V : Ouvre « Utilisateurs »
V --> A : Liste des comptes + formulaire d'ajout
A -> V : Renseigne les données et clique « Ajouter »
V -> C : POST (nom, prénom, email, rôle, csrf)
C -> C : Vérifie CSRF + valide les champs
C -> B : Vérifie l'unicité de l'email
alt Email unique
  C -> B : INSERT INTO utilisateur (hash bcrypt)
  B --> C : OK
  C -> J : INSERT INTO admin_audit (action)
  J --> C : OK
  C --> A : Message de succès + liste rafraîchie
else Email déjà utilisé
  C --> A : Message « Un compte existe déjà »
end
@enduml