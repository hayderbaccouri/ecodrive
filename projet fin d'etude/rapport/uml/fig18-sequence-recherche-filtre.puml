@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
title Diagramme de séquence « Rechercher et filtrer le catalogue »

actor "Visiteur" as V
participant "Vue\ncatalogue.php" as P
participant "Contrôleur PHP" as C
database "Base de données\n(voiture)" as B

V -> P : Ouvre le catalogue
P --> V : Première page (9 véhicules)
V -> P : Saisit mot-clé, filtres (marque, prix, année) et tri
P -> C : GET (q, brand, min/max, year, sort, page)
C -> C : Assemble les clauses WHERE / ORDER BY / LIMIT
C -> B : Exécute la requête préparée
B --> C : Résultats (véhicules filtrés)
C --> P : Données pour le rendu
P --> V : Affichage de la liste paginée
@enduml