@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam componentStyle rectangle
title Le modèle MVC appliqué à EcoDrive

actor "Navigateur (Client)" as Client

package "Vue (affichage)" as V {
  component "Partials : header, footer, meta, jsonld" as V1
  component "Pages HTML générées" as V2
  component "CSS / JavaScript / Chart.js / Leaflet" as V3
}

package "Contrôleur (logique applicative)" as C {
  component "connexion.php" as C1
  component "inscription.php" as C2
  component "catalogue.php" as C3
  component "reservation.php" as C4
  component "admin.php" as C5
  component "contact + newsletter" as C6
}

package "Modèle (données)" as M {
  component "ecodrive.sql (schéma + données)" as M1
  component "car_data.php / data.php (jeux de données)" as M2
  component "Accès base : mysqli, requêtes préparées" as M3
}

Client --> C : "requêtes HTTP"
C --> M : "lire / écrire les données"
C --> V : "sélectionner et afficher la vue"
V3 --> C1
V3 --> C3
@enduml