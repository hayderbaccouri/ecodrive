@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
title Cas d'utilisation « Gérer les utilisateurs »

actor "Administrateur" as A
actor "Client" as Cl
actor "Journal d'audit\n(admin_audit)" as J

A --> (Gérer les utilisateurs)
A --> (Rechercher un utilisateur)
Cl --> (Modifier son profil)

(Rechercher un utilisateur) ..> (Gérer les utilisateurs) : <<extend>>
(Ajouter un utilisateur) ..> (Gérer les utilisateurs) : <<extend>>
(Modifier le rôle) ..> (Gérer les utilisateurs) : <<extend>>
(Supprimer un utilisateur) ..> (Gérer les utilisateurs) : <<extend>>
(Gérer les utilisateurs) ..> (Journaliser l'action) : <<include>>
(Journaliser l'action) -> J
@enduml