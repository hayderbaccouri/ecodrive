@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
title Diagramme de séquence « Réserver un essai »

actor "Client" as C
participant "Vue\nreservation.php" as V
participant "Contrôleur PHP" as Ctrl
database "Base de données\n(reservation)" as B
participant "Système de messagerie" as M

C -> V : Choisit un véhicule, clique « Réserver un essai »
V --> C : Formulaire en 2 étapes (véhicule, créneau)
C -> V : Choisit la date et l'heure (créneau d'1 h)
V -> Ctrl : POST (id_voiture, date_essai, heure, csrf)
Ctrl -> B : Vérifie les règles (jour, heure, conflit)

alt Créneau valide
  Ctrl -> B : INSERT INTO reservation (statut = pending)
  B --> Ctrl : OK
  Ctrl -> M : Envoie l'e-mail de confirmation
  M --> C : E-mail reçu
  Ctrl --> C : Page de confirmation + export .ics
else Créneau indisponible ou invalide
  B --> Ctrl : Conflit détecté
  Ctrl --> C : Message d'erreur (créneau déjà réservé, dimanche, hors 8 h - 17 h)
end
@enduml