@startwbs
!theme plain
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam nodeSep 15
skinparam rankSep 25
scale 1.5

<style>
wbsDiagram {
    arrow {
        LineColor #2E74B5
    }
    .root {
        BackgroundColor #1F4E79
        FontColor white
        FontStyle bold
    }
    node {
        BackgroundColor #DDEBF7
        FontColor #1F4E79
        LineColor #2E74B5
    }
    leafNode {
        BackgroundColor white
        FontColor #2E74B5
        LineColor #2E74B5
    }
}
</style>

